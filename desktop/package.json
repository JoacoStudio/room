{
  "name": "room",
  "productName": "Room",
  "version": "1.0.0",
  "description": "Organizador de notas minimalista (blanco y negro, sin botones en la nota). Almacenamiento 100% local.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "files": [
    "**/*"
  ],
  "win": {
    "target": "nsis",
    "sign": false,
    "icon": "Ic.ico"
  },
  "keywords": [
    "notas",
    "minimalista",
    "electron",
    "local",
    "offline"
  ],
  "author": "",
  "build": {
    "icon": "Ic.ico"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
